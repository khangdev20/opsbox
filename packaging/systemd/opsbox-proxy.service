[Unit]
Description=opsbox reverse proxy
Documentation=https://github.com/khangdev20/opsbox
After=network-online.target opsbox-priv.service
Wants=network-online.target opsbox-priv.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=opsbox
Group=opsbox
ExecStart=/usr/local/bin/opsbox proxy
Restart=always
RestartSec=2

# Hardening (docs/BACKEND_SPEC.md section 4). proxy is internet-facing on :80/:443,
# holds only CAP_NET_BIND_SERVICE, and encrypts/decrypts keys via opsbox-priv.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/opsbox/proxy
InaccessiblePaths=/var/lib/opsbox/xfer
# The panel creates the DB after proxy startup on a fresh install. Until then,
# ProtectSystem=strict keeps its parent read-only; an existing DB is hidden.
InaccessiblePaths=-/var/lib/opsbox/opsbox.db
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
MemoryMax=256M

# Creates /run/opsbox-proxy (opsbox:opsbox 0755) for proxy.sock and preserves it across restarts.
RuntimeDirectory=opsbox-proxy
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target

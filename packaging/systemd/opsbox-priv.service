[Unit]
Description=opsbox privileged helper
Documentation=https://github.com/khangdev20/opsbox
# Never give up restarting: the watchdog (Phase 2) decides when to roll back.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/opsbox priv
Restart=always
RestartSec=2

# Runs as root, but owns no network: it only speaks on its Unix socket
# (docs/BACKEND_SPEC.md section 2). It must not be fully sandboxed, because the
# operations it will gain in later phases (packages, systemd, firewall, files) act on
# the whole system. Tighten per operation as they land, not here.
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

# Creates /run/opsbox (root:root 0755) for the socket and keeps it across restarts,
# so `serve` does not lose its directory when `priv` restarts.
RuntimeDirectory=opsbox
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target

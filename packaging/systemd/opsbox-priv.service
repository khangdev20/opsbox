[Unit]
Description=opsbox privileged helper
Documentation=https://github.com/khangdev20/opsbox
# Never give up restarting: the watchdog (Phase 2) decides when to roll back.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/opsbox priv
Restart=always
RestartSec=2

# Runs as root. priv itself listens only on its Unix socket and never opens a network
# listener, but the tools it runs for you inherit these limits: apt and dnf download
# over IPv4/IPv6, nft and ufw talk netlink, systemctl and journalctl use Unix sockets.
# Everything else (packet sockets, vsock, ...) stays closed. It must not be fully
# sandboxed, because its operations act on the whole system; tighten per operation.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

# Creates /run/opsbox (root:root 0755) for the socket and keeps it across restarts,
# so `serve` does not lose its directory when `priv` restarts.
RuntimeDirectory=opsbox
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
